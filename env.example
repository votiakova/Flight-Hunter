# Скопируй этот файл в .env и заполни значения

# Токен Telegram бота (от @BotFather)
TELEGRAM_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ignav API ключ (ignav.com/signup — бесплатно)
# Можно оставить пустым и задать через /setkey прямо в боте
IGNAV_API_KEY=igv_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ограничение доступа к боту (опционально)
# Укажи свой Telegram chat_id, чтобы бот отвечал только тебе
# Узнать chat_id: написать @userinfobot в Telegram
# Если оставить пустым — бот доступен всем
ALLOWED_CHAT_IDS=123456789
